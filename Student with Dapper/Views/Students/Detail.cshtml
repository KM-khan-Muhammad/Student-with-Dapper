@model Student_with_Dapper.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="glass-card animate-slide-up p-0 overflow-hidden">
            <!-- Header -->
            <div class="p-4 bg-primary text-white text-center">
                <h1 class="h3 mb-1 fw-bold">Student Profile</h1>
                <p class="mb-0 opacity-75 small">System Record ID: #@Model.Id</p>
            </div>

            <!-- Profile Info -->
            <div class="p-4 p-md-5">
                <div class="text-center mb-5">
                    <div class="display-1 fw-bold text-primary mb-3">
                        @Model.Name.Substring(0, 1).ToUpper()
                    </div>
                    <h2 class="h2 fw-bold text-primary-emphasis mb-0">@Model.Name</h2>
                    <p class="text-muted">@Model.Email</p>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-sm-6">
                        <div class="h-100 p-3 rounded-3 bg-body-secondary border border-white border-opacity-10">
                            <label class="small text-uppercase fw-bold text-muted d-block mb-1">Age</label>
                            <div class="h5 mb-0 fw-bold text-primary-emphasis">@Model.Age Years</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="h-100 p-3 rounded-3 bg-body-secondary border border-white border-opacity-10">
                            <label class="small text-uppercase fw-bold text-muted d-block mb-1">Registration</label>
                            <div class="h5 mb-0 fw-bold text-primary-emphasis">@Model.CreatedDate.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center pt-4 border-top">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-3 px-5 py-2 fw-bold">
                        <i class="fas fa-edit me-2"></i>Edit Student
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-5 py-2">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>
            
            <div class="p-3 bg-body-tertiary text-center border-top">
                <small class="text-muted">Last updated on @DateTime.Now.ToString("MMMM dd, yyyy")</small>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-avatar {
        animation: float 4s ease-in-out infinite;
    }
    
    @@keyframes float {
        0%, 100% { transform: translate(-50%, 0); }
        50% { transform: translate(-50%, -10px); }
    }
</style>
