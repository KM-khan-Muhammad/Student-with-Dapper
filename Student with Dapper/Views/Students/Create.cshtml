@model Student_with_Dapper.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="glass-card animate-slide-up">
            <div class="mb-5">
                <h2 class="h3 fw-bold text-primary-emphasis mb-1">Add New Student</h2>
                <p class="text-muted small">Please fill in the information below to register a student.</p>
            </div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label small fw-bold text-uppercase text-muted">Full Name</label>
                    <input asp-for="Name" class="form-control form-control-lg rounded-3 bg-body-secondary border-0" placeholder="Enter student name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label small fw-bold text-uppercase text-muted">Email Address</label>
                    <input asp-for="Email" class="form-control form-control-lg rounded-3 bg-body-secondary border-0" placeholder="student@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Age" class="form-label small fw-bold text-uppercase text-muted">Age</label>
                    <input asp-for="Age" class="form-control form-control-lg rounded-3 bg-body-secondary border-0" placeholder="e.g. 21" />
                    <span asp-validation-for="Age" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-column gap-3">
                    <button type="submit" class="btn btn-primary rounded-3 py-3 fw-bold shadow-sm">
                        <i class="fas fa-plus-circle me-2"></i>Register Student
                    </button>
                    <a asp-action="Index" class="btn btn-link text-muted text-decoration-none text-center">
                        <i class="fas fa-arrow-left me-1"></i>Back to Directory
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}